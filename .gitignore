# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/
dist/
var/
.devctl/

# Local visual review artifacts generated by css-visual-diff
css-visual-diff-compare-*/
ttmp/**/artifacts/storybook-visuals/

# misc files and directories
.env
.envrc
.history

# Local pnpm store (env global store-dir is read-only in this sandbox)
.tmp-pnpm-store/
