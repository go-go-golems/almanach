{
  "name": "almanach-studio-build",
  "version": "1.0.0",
  "private": true,
  "description": "Build pipeline for Almanach Studio SPA — precompiles JSX into a minified IIFE bundle for ESP32 embedding",
  "scripts": {
    "dev": "vite",
    "build": "node esbuild.mjs",
    "build:dev": "node esbuild.mjs --dev",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "storybook build",
    "test:proto": "node test/layout.roundtrip.test.mjs",
    "test:registry": "node src/blocks/registry.test.mjs",
    "test:web": "node test/layout.roundtrip.test.mjs && node src/blocks/registry.test.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@noble/curves": "^2.2.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@storybook/react-vite": "^10.3.6",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.25.2",
    "storybook": "^10.3.6",
    "vite": "^8.0.10"
  },
  "packageManager": "pnpm@10.15.0",
  "type": "module"
}
